# file .editorconfig
#
# @version 1.0.0
# @author BleckWolf25
# @contributors
# @license MIT
#
# @description
# Configuration file for the EditorConfig.
# EditorConfig is a file format that defines coding styles for multiple programming languages.
#
# @since 2025-12-18
# @updated 2025-12-18
#
# @see {@link https://editorconfig.org | EditorConfig documentation}
# @see {@link https://github.com/editorconfig/editorconfig | EditorConfig repository}
#
# ---------- CONFIGURATIONS
# EditorConfig file at the root level - prevents searching in parent directories
root = true

# Default configurations for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# TypeScript and JavaScript files
[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2
max_line_length = 110
insert_final_newline = true
trim_trailing_whitespace = true

# JSON configuration files
[*.{json,jsonc}]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# YAML files - Docker Compose, CI/CD, Kubernetes
[*.{yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown configuration files
[*.{md,mdx}]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2
max_line_length = 120
insert_final_newline = true

# SQL configuration files
[*.sql]
indent_style = space
indent_size = 4
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

# Environment variables
[.env*]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = true

# Shell script configuration files
[*.{sh,bash,zsh,fish}]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Windows configuration files
[*.{bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 2

# Makefile configuration files
[{Makefile,makefile,*.mk}]
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Docker configuration files
[{Dockerfile,*.dockerfile,docker-compose*.yml}]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# XML, HTML and SVG configuration files
[*.{xml,html,htm,svg}]
indent_style = space
indent_size = 2
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

# CSS, SCSS configuration files
[*.{css,scss,sass,less,styl}]
indent_style = space
indent_size = 2
max_line_length = 100
insert_final_newline = true
trim_trailing_whitespace = true

# Block confiugration
[*.{lock,resolved}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false

# Bin configuration files
[*.{png,jpg,jpeg,gif,ico,svg,woff,woff2,eot,ttf,otf}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
