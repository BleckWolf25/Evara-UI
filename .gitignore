# @file .gitignore
#
# @version 1.1.0
# @author BleckWolf25
# @license MIT
#
# @description
# gitignore for Evara-UI monorepo.
# Ignores dependencies, build artifacts, caches, logs, and IDE-specific files.
#
# @created 2025-12-18
# @updated 2025-12-19
#
# @see {@link https://git-scm.com/docs/gitignore | gitignore documentation}
# @see {@link https://github.com/github/gitignore | Standard .gitignore templates}
#
# ============================================================================
# DEPENDENCIES & PACKAGE MANAGERS
# ============================================================================
# npm
node_modules/
package-lock.json
npm-debug.log*
npm-error.log*

# pnpm
pnpm-lock.yaml.backup
.pnp
.pnp.*

# yarn
yarn-error.log*
yarn-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# jspm
jspm_packages/

# Snowpack
web_modules/

# Bower
bower_components/

# ============================================================================
# BUILD ARTIFACTS & DISTRIBUTIONS
# ============================================================================

# Dist directories
dist/
dist-*
build/
build/Release
.next/
out/
.nuxt/
.vuepress/dist/
.docusaurus/

# Compiled TypeScript
*.tsbuildinfo
*.tsbuild.json

# Package archives
*.tgz
*.tar.gz

# ============================================================================
# CACHES & TEMPORARY FILES
# ============================================================================

# Node.js
.node_repl_history
.npm/

# Turbo (monorepo build tool)
.turbo/
.turbo

# Vitest/Jest
.vitest/
.vitest

# ESLint
.eslintcache

# Stylelint
.stylelintcache

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Parcel
.cache/
.parcel-cache/

# Cache directories
.cache/
.temp/

# Precompiled headers
.vscode/

# ============================================================================
# SVELTEKIT & FRAMEWORK CACHES
# ============================================================================

.svelte-kit/
.vitepress/cache/
.vitepress/dist/

# ============================================================================
# LOGS & CRASH DUMPS
# ============================================================================

# General logs
logs/
*.log
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# ============================================================================
# TESTING & COVERAGE
# ============================================================================

# Coverage reports
coverage/
.nyc_output/
*.lcov

# Test results
test-results/
.test-cache/

# Playwright (E2E Testing)
e2e/playwright-report/
e2e/playwright-traces/
e2e/test-results/
playwright-report/
playwright-traces/

# ============================================================================
# IDE & EDITOR SPECIFIC
# ============================================================================

# VS Code
.vscode/
.vscode-test/
*.code-workspace

# JetBrains IDEs
.idea/
.idea_modules/
*.iml
*.iws
*.ipr
.DS_Store

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# Nano
.swp

# ============================================================================
# ENVIRONMENT & CONFIGURATION
# ============================================================================

# Environment files
.env
.env.*
!.env.example

# Local overrides
.local/
.config.local.*

# ============================================================================
# OS SPECIFIC
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory

# ============================================================================
# DEVELOPMENT TOOLS & EXTENSIONS
# ============================================================================

# Husky (Git Hooks)
.husky/

# Snyk Security
.snyk
.github/instructions/snyk_rules.instructions.md

# AI Tools & Agents
mcp.json
agents/default.json
*/agents/default.json
.qodo/

# Changesets
.changeset/CHANGELOG.md

# ============================================================================
# THIRD-PARTY SERVICES
# ============================================================================

# Firebase
.firebase/
.firebaserc

# Serverless
.serverless/

# DynamoDB Local
.dynamodb/

# TernJS
.tern-port

# FuseBox
.fusebox/

# ============================================================================
# BUILD TOOL ARTIFACTS
# ============================================================================

# Grunt
.grunt/

# Gulp
gulpfile.js.backup

# Webpack/Vite
.webpackcache/
dist-webpack/

# Node-gyp
build/

# Compiled binary addons
build/Release/

# ============================================================================
# LOCK FILES (Optional - uncomment if preferred)
# ============================================================================

# Uncomment to ignore lock files (use with caution in monorepos)
# pnpm-lock.yaml
# yarn.lock
# package-lock.json
