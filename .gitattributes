# @file .gitattributes
#
# @version 1.0.0
# @author BleckWolf25
# @license MIT
#
# @description
# Git attributes configuration for Evara-UI monorepo.
# Normalizes line endings, handles binary files, and configures export behavior.
#
# @created 2025-12-19
# @updated 2025-12-19
#
# @see {@link https://git-scm.com/docs/gitattributes | gitattributes documentation}
#
# ============================================================================
# AUTO NORMALIZE LINE ENDINGS
# ============================================================================

# Auto detect text files and normalize line endings to LF
* text=auto

# ============================================================================
# TEXT FILES (LF line endings)
# ============================================================================

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.vue text eol=lf
*.svelte text eol=lf

# Markup & templating
*.html text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Styling
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.postcss text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf

# Documentation & misc text
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf
.prettierignore text eol=lf
package.json text eol=lf
pnpm-workspace.yaml text eol=lf
tsconfig*.json text eol=lf
turbo.json text eol=lf
vitest.config.js text eol=lf
vitest.workspace.js text eol=lf
eslint.config.ts text eol=lf
prettier.config.js text eol=lf

# ============================================================================
# LOCK FILES (LF line endings, merge conflicts allowed)
# ============================================================================

pnpm-lock.yaml text eol=lf merge=union
yarn.lock text eol=lf merge=union
package-lock.json text eol=lf merge=union

# ============================================================================
# BINARY FILES
# ============================================================================

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary diff=exif
*.ico binary
*.tiff binary
*.bmp binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.tar.gz binary
*.tgz binary
*.rar binary
*.7z binary

# Compiled/binary files
*.o binary
*.obj binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary

# Media
*.mp3 binary
*.mp4 binary
*.mpeg binary
*.mpg binary
*.mov binary
*.wav binary
*.flac binary

# PDFs & documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# ============================================================================
# DIFF & MERGE SETTINGS
# ============================================================================

# Minified files - don't show meaningful diffs
*.min.js diff=minified
*.min.css diff=minified

# Package lock files - generate diffs for changes
pnpm-lock.yaml diff=lockfile

# ============================================================================
# EXPORT-IGNORE PATTERNS (Exclude from distributions)
# ============================================================================

# Development & testing
**/*.test.ts export-ignore
**/*.test.tsx export-ignore
**/*.test.js export-ignore
**/*.test.jsx export-ignore
**/*.spec.ts export-ignore
**/*.spec.tsx export-ignore
**/*.spec.js export-ignore
**/*.spec.jsx export-ignore
**/vitest.config.* export-ignore
**/jest.config.* export-ignore
coverage/ export-ignore
.nyc_output/ export-ignore

# Documentation & examples
docs/ export-ignore
examples/ export-ignore
*.md export-ignore
README.md export-ignore
CONTRIBUTING.md export-ignore
CHANGELOG.md export-ignore
CODE_OF_CONDUCT.md export-ignore
SECURITY.md export-ignore
AGENTS.md export-ignore

# Development configuration
.github/ export-ignore
.vscode/ export-ignore
.husky/ export-ignore
.editorconfig export-ignore
.prettierignore export-ignore
.eslintignore export-ignore
eslint.config.ts export-ignore
prettier.config.js export-ignore
vitest.config.js export-ignore
vitest.workspace.js export-ignore
turbo.json export-ignore
tsconfig.json export-ignore
tsconfig.base.json export-ignore
.npmrc export-ignore
.nvmrc export-ignore

# CI/CD & automation
.github/ export-ignore
.qodo/ export-ignore

# IDE & editor
.idea/ export-ignore
.vscode/ export-ignore
*.sublime-project export-ignore
*.sublime-workspace export-ignore
.DS_Store export-ignore

# Root development files
vitest.workspace.js export-ignore
pnpm-workspace.yaml export-ignore
.gitignore export-ignore
.gitattributes export-ignore
