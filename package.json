{
  "$schema": "https://json.schemastore.org/package",
  "name": "evara-ui",
  "version": "1.0.0",
  "description": "Evara is an open-source, highly scalable UI library and design system. It provides modular, consistent, and testable components with built-in support for performance optimization, SEO, analytics, and backend-driven workflows.",
  "author": {
    "name": "BleckWolf25",
    "url": "https://bleckwolf25.vercel.app"
  },
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "overrides": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "node scripts/cleanup.js && pnpm install",
    "dev": "turbo run dev --parallel",
    "docs:dev": "pnpm --filter @bleckwolf25/docs dev",
    "docs:build": "pnpm --filter @bleckwolf25/docs build",
    "docs:preview": "pnpm --filter @bleckwolf25/docs preview",
    "dev:react": "pnpm --filter @bleckwolf25/react-vite-showcase dev",
    "dev:next": "pnpm --filter @bleckwolf25/react-nextjs-app dev",
    "dev:vue": "pnpm --filter @bleckwolf25/vue-vite-showcase dev",
    "dev:nuxt": "pnpm --filter @bleckwolf25/nuxt-app dev",
    "dev:vanilla": "pnpm --filter @bleckwolf25/core-vanilla-html dev",
    "dev:webcomponents": "pnpm --filter @bleckwolf25/core-webcomponents dev",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @bleckwolf25/e2e test",
    "test:coverage": "turbo run test -- --coverage",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "release": "turbo run build && changeset publish",
    "cleanup": "node scripts/cleanup.js"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.6",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "pnpm@10.25.0"
}
