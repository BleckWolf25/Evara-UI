{
  "name": "@bleckwolf25/svelte",
  "version": "1.0.0",
  "description": "Svelte components and stores for Evara UI design system",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bleckwolf25/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "svelte": "^4.2.18",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0-0"
  },
  "publishConfig": {
    "access": "public"
  }
}
