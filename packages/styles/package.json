{
  "$schema": "https://json.schemastore.org/package",
  "name": "@evara-ui/styles",
  "version": "1.0.0",
  "description": "Design tokens and styles for Evara UI",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "author": {
    "name": "BleckWolf25",
    "url": "https://bleckwolf25.vercel.app"
  },
  "main": "./dist/index.css",
  "module": "./dist/index.css",
  "exports": {
    ".": {
      "default": "./dist/index.css"
    },
    "./index.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css",
    "./tokens/*": "./dist/tokens/*.css",
    "./themes/*": "./dist/themes/*.css",
    "./base/*": "./dist/base/*.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build-css.js",
    "dev": "node scripts/build-css.js --watch",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src --fix --no-error-on-unmatched-pattern"
  }
}
